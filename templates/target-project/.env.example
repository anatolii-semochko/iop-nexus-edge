# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.
#
# Generated by nexus-edge's `make new-project` - port defaults below are
# a starting point (offset from nexus-edge's own dev stack), NOT
# scanned for actual collisions. Check `docker ps` / `docker compose
# ls` before running this alongside other projects and adjust anything
# that clashes (docs/CREATING_A_TARGET_PROJECT.md's "Known trap"
# section has the full story on why EDGEX_*_PORT vars specifically are
# not safe to just reassign).

NODE_ENV=development

# --- This project's identity + where nexus-edge (Core+Base) lives
# (Фаза В extension points design, nexus-edge AGENTS_TO_DO.md 2026-07-29) ---
# Shown in the UI next to the logo (apps/ui/src/projectName.js).
PROJECT_NAME=__PROJECT_NAME__
# Absolute or relative path to a nexus-edge checkout - not required to
# be a sibling directory (docker-compose.yml's build.context/
# additional_contexts read this). Lets several nexus-edge versions be
# checked out side by side for active development, each target project
# pointing at whichever one it needs.
NEXUS_EDGE_SOURCE_PATH=__NEXUS_EDGE_SOURCE_PATH__
# nexus-edge's own package.json "version" at the time this project was
# generated/last updated - compared against the current value at
# NEXUS_EDGE_SOURCE_PATH by `make build` (warns on mismatch, does not
# block).
NEXUS_EDGE_VERSION=__NEXUS_EDGE_VERSION__

# --- Orchestrator ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=3120

# --- Device API ---
API_HOST=0.0.0.0
API_PORT=3121

# --- Messaging Gateway (RabbitMQ -> WebSocket fan-out for the UI) ---
MESSAGING_GATEWAY_HOST=0.0.0.0
MESSAGING_GATEWAY_PORT=3131

# --- UI ---
UI_PORT=8081

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=__SLUG__
POSTGRES_USER=__SLUG__
POSTGRES_PASSWORD=change-me
# Host-side port only, for connecting a local client from outside Docker
# - a non-standard default so it doesn't collide with nexus-edge's own
# dev stack (POSTGRES_HOST_PORT=55432 there) or a local Postgres.
POSTGRES_HOST_PORT=55532

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=__SLUG__
RABBITMQ_DEFAULT_PASS=change-me

# --- Process public-state broadcast ---
PROCESS_STATE_BROADCAST_INTERVAL_MS=5000

# --- Auth (UI login only) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
ADMIN_DEFAULT_PASSWORD=change-me
SYSTEM_DEFAULT_PASSWORD=change-me
AVATAR_UPLOAD_DIR=/workspace/apps/api/uploads/avatars
AVATAR_MAX_SIZE_BYTES=2097152

# --- EdgeX Foundry (Palau 4.0.2, no-security profile) ---
EDGEX_CORE_METADATA_HOST=edgex-core-metadata
# Always 59881 - EdgeX's own container-internal listen port, unrelated
# to whatever host port docker-compose.edgex.yml maps it to for local
# debugging. Do not change (bug found 2026-07-28, nexus-edge-smart-house:
# this was set to a host-only offset port here, which broke apps/api's
# own internal EdgeX connection - GET /devices list silently returned
# edgex:null for every device, ECONNREFUSED in api's logs).
EDGEX_CORE_METADATA_PORT=59881
EDGEX_CORE_DATA_HOST=edgex-core-data
EDGEX_CORE_DATA_PORT=59880
EDGEX_CORE_COMMAND_HOST=edgex-core-command
EDGEX_CORE_COMMAND_PORT=59882
EDGEX_CORE_KEEPER_HOST=edgex-core-keeper
EDGEX_CORE_KEEPER_PORT=59890
# Host-side debug port only (docker-compose.edgex.yml) - give this a
# project-unique value if running several target projects side by side.
EDGEX_METADATA_HOST_PORT=59981
