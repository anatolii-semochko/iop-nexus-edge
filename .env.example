# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file (see .gitignore).

NODE_ENV=development

# Fastify's own per-request auto-logging (api/orchestrator) - "info"
# logs every incoming request + completed response, 2 JSON lines each.
# Real, measurable CPU/IO cost under sustained internal traffic (found
# live 2026-08-29 on a Raspberry Pi: the orchestrator's own 1Hz tick
# touching 20+ individual devices with no batch endpoint adds up to
# ~50-60 req/s by design). Set to "warn" on a resource-constrained
# deployment to drop the per-request noise while keeping real
# logger.warn()/error() calls visible; leave at the default "info" for
# local dev where that visibility is usually worth the cost.
LOG_LEVEL=info

# Demo/dev fixtures (light-regulator-01, active-buzzer-01,
# example-thermal-node's devices+processes, heartbeat-control-test) -
# convenient for THIS repo's own local dev loop, but a target project
# built on nexus-edge should start clean and add/register Library
# components itself (AGENTS.md section 31). Leave unset/false for any
# target project; nexus-edge's own local .env sets this to "true".
SEED_DEMO_FIXTURES=false

# --- Orchestrator ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=3000
# Timeout for each apiClient.ts request against apps/api - generous
# relative to normal response times, bounded so a single hung call can
# never freeze the tick loop's own re-entrancy guard forever.
API_REQUEST_TIMEOUT_MS=10000

# --- Device API ---
API_HOST=0.0.0.0
API_PORT=3001

# --- Messaging Gateway (RabbitMQ -> WebSocket fan-out for the UI) ---
MESSAGING_GATEWAY_HOST=0.0.0.0
MESSAGING_GATEWAY_PORT=3030

# --- UI ---
UI_PORT=8080

# --- PostgreSQL (platform storage: Device Registry, etc.) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus_edge
POSTGRES_USER=nexus_edge
POSTGRES_PASSWORD=change-me
# Host-side port only (docker-compose.yml's postgres service, bound to
# 127.0.0.1) - for connecting a local client (psql, a GUI tool) from
# outside Docker. Deliberately a separate variable from POSTGRES_PORT
# above, which apps use internally to reach the postgres container over
# the docker network and stays 5432 regardless - a non-standard default
# here so this doesn't collide with a Postgres already running locally on
# the standard 5432.
POSTGRES_HOST_PORT=55432

# --- Redis (Dual Devices Model state store) ---
REDIS_HOST=redis
REDIS_PORT=6379
# Host-side debug port only (see POSTGRES_HOST_PORT's comment above -
# same reasoning) - non-standard default so it doesn't collide with a
# Redis already running locally on the standard 6379.
REDIS_HOST_PORT=16379

# --- RabbitMQ (Event Bus - device/node data and commands only, AGENTS.md
# section 24; process public state does not go through here) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Host-side debug ports only, same reasoning as REDIS_HOST_PORT above.
RABBITMQ_HOST_PORT=15673
RABBITMQ_MANAGEMENT_HOST_PORT=25673
RABBITMQ_DEFAULT_USER=nexus_edge
RABBITMQ_DEFAULT_PASS=change-me

# --- Process public-state broadcast (AGENTS.md section 24) ---
# How often apps/api re-broadcasts the whole fleet's public process state
# (status/critical/warning/metrics/active messages) via Redis to
# apps/messaging-gateway, independent of the orchestrator's own 1s compute
# tick. Urgent changes (critical/warning transitions, a new active WEM
# entry, or an explicit forced broadcast) push immediately regardless of
# this interval.
PROCESS_STATE_BROADCAST_INTERVAL_MS=5000

# --- Auth (UI login only - see AGENTS.md section 13) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Seeded once by apps/api/migrations/..._seed-default-users.ts - change both
# for any real deployment, this file is committed to git.
ADMIN_DEFAULT_PASSWORD=change-me
SYSTEM_DEFAULT_PASSWORD=change-me
AVATAR_UPLOAD_DIR=/workspace/apps/api/uploads/avatars
AVATAR_MAX_SIZE_BYTES=2097152

# --- Service->Commands (AGENTS_TO_DO.md, 2026-08-30) ---
# Host power commands via a D-Bus call to systemd-logind
# (org.freedesktop.login1) - requires /run/dbus/system_bus_socket mounted
# into the api container (docker-compose.yml). Both default false: the
# route and UI exist unconditionally, but stay hidden/403 until an
# operator opts in on a deployment where shutting down the container's
# host is actually intended (e.g. a Raspberry Pi, not a shared dev box).
SHUTDOWN_ENABLE=false
RESTART_ENABLE=false

# --- Service->Database (AGENTS_TO_DO.md, 2026-08-30) ---
# Where "System Stamp" snapshots (Save/Apply/Download/Upload State) are
# written - plain JSON files, not a database table.
SYSTEM_STAMPS_DIR=/workspace/apps/api/uploads/system-stamps
SYSTEM_STAMP_MAX_SIZE_BYTES=52428800

# --- EdgeX Foundry (Palau 4.0.2, no-security profile) ---
EDGEX_CORE_METADATA_HOST=edgex-core-metadata
EDGEX_CORE_METADATA_PORT=59881
EDGEX_CORE_DATA_HOST=edgex-core-data
EDGEX_CORE_DATA_PORT=59880
EDGEX_CORE_COMMAND_HOST=edgex-core-command
EDGEX_CORE_COMMAND_PORT=59882
EDGEX_CORE_KEEPER_HOST=edgex-core-keeper
EDGEX_CORE_KEEPER_PORT=59890
